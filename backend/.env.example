# Core
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# Database (sqlite for local dev, Postgres in production)
DATABASE_URL=sqlite:///./printshop.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/printshop

# File storage: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# S3_BUCKET=my-print-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=   # set for R2 / MinIO
MAX_UPLOAD_MB=200

# Payments: fake | stripe
PAYMENT_PROVIDER=fake
CURRENCY=cad
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Email: console | smtp
EMAIL_BACKEND=console
EMAIL_FROM=orders@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Optional: create this admin on startup if it does not exist
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# Shipping (flat rates in cents)
SHIPPING_STANDARD_CENTS=1500
SHIPPING_EXPRESS_CENTS=3500
